default_platform(:ios)

TEAMID = ENV["TEAMID"]
GH_PAT = ENV["GH_PAT"]
GITHUB_WORKSPACE = ENV["GITHUB_WORKSPACE"]
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
DEVICE_NAME = ENV["DEVICE_NAME"]
DEVICE_ID = ENV["DEVICE_ID"]
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

# Reads the per-app suffix from LoopFollowDisplayNameConfig.xcconfig so the same
# Fastfile produces the correct bundle identifiers in every sister repository
# (LoopFollow, LoopFollow_Second, LoopFollow_Third) without per-repo edits.
def loopfollow_app_suffix
  root = GITHUB_WORKSPACE || File.expand_path("..", __dir__)
  path = File.join(root, "LoopFollowDisplayNameConfig.xcconfig")
  return "" unless File.exist?(path)

  File.foreach(path) do |line|
    next if line.strip.start_with?("//")
    if (match = line.match(/^\s*app_suffix\s*=\s*(.*)$/))
      return match[1].strip
    end
  end
  ""
end

APP_SUFFIX = loopfollow_app_suffix
APP_IDENTIFIER = "com.#{TEAMID}.LoopFollow#{APP_SUFFIX}"
LA_IDENTIFIER = "#{APP_IDENTIFIER}.LoopFollowLAExtension"
TV_IDENTIFIER = APP_IDENTIFIER
MOOBYTE_TV_IDENTIFIER = "local.rabbitload.tv"
MOOBYTE_IOS_IDENTIFIER = "local.rabbitload"
MOOBYTE_WATCH_IDENTIFIER = "local.rabbitload.watch"
MOOBYTE_MAC_IDENTIFIER = "local.rabbitload.mac"
MOOBYTE_WIDGET_IDENTIFIER = "local.rabbitload.widgets"
MOOBYTE_SAFARI_IDENTIFIER = "local.rabbitload.safari"
MOOBYTE_SHARE_IDENTIFIER = "local.rabbitload.share"
MOOBYTE_MAC_SAFARI_IDENTIFIER = "local.rabbitload.mac.safari"

platform :ios do
  desc "Build Loop Follow"
  lane :build_LoopFollow do
    setup_ci if ENV['CI']
    
    update_project_team(
      path: "#{GITHUB_WORKSPACE}/LoopFollow.xcodeproj",
      teamid: "#{TEAMID}"
    )

    api_key = app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    previous_build_number = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
    )

    current_build_number = previous_build_number + 1

    increment_build_number(
      xcodeproj: "#{GITHUB_WORKSPACE}/LoopFollow.xcodeproj",
      build_number: current_build_number
    )      
    
    match(
      type: "appstore",
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [
        APP_IDENTIFIER,
        LA_IDENTIFIER
      ]
    )

    mapping = Actions.lane_context[
      SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING
    ]

    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/LoopFollow.xcodeproj",
      profile_name: mapping[APP_IDENTIFIER],
      code_sign_identity: "iPhone Distribution",
      targets: ["LoopFollow"]
    )

    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/LoopFollow.xcodeproj",
      profile_name: mapping[LA_IDENTIFIER],
      code_sign_identity: "iPhone Distribution",
      targets: ["LoopFollowLAExtensionExtension"]
    )

    gym(
      export_method: "app-store",
      scheme: "LoopFollow",
      output_name: "LoopFollow.ipa",
      configuration: "Release",
      destination: 'generic/platform=iOS',
      buildlog_path: 'buildlog',
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => mapping[APP_IDENTIFIER],
          LA_IDENTIFIER => mapping[LA_IDENTIFIER]
        }
      }
    )

    copy_artifacts(
      target_path: "artifacts",
      artifacts: ["*.mobileprovision", "*.ipa", "*.dSYM.zip"]
    )
  end

  desc "Push to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )
    
    upload_to_testflight(
      api_key: api_key,
      skip_submission: false,
      ipa: "LoopFollow.ipa",
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Provision Identifiers and Certificates"
  lane :identifiers do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    
    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    def configure_bundle_id(name, identifier, capabilities)
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier) || Spaceship::ConnectAPI::BundleId.create(
        name:       name,
        identifier: identifier,
        platform:   "IOS"
      )
      existing = bundle_id.get_capabilities.map(&:capability_type)
      capabilities.reject { |c| existing.include?(c) }.each do |cap|
        bundle_id.create_capability(cap)
      end
    end

    configure_bundle_id("LoopFollow", APP_IDENTIFIER, [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS,
      Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    ])

    configure_bundle_id("LoopFollow Live Activity Extension", LA_IDENTIFIER, [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS
    ])

  end

  desc "Provision Certificates"
  lane :certs do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    
    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )
    
    match(
      type: "appstore",
      force: false,
      verbose: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [
        APP_IDENTIFIER,
        LA_IDENTIFIER
      ]
    )
  end

  desc "Validate Secrets"
  lane :validate_secrets do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = true.to_s

    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )

    match(
      type: "appstore",
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [],
    )
  end

  desc "Nuke Certs"
  lane :nuke_certs do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    
    app_store_connect_api_key(
      key_id: "#{FASTLANE_KEY_ID}",
      issuer_id: "#{FASTLANE_ISSUER_ID}",
      key_content: "#{FASTLANE_KEY}"
    )
    
    match_nuke(
      type: "appstore",
      team_id: "#{TEAMID}",
      skip_confirmation: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
    )
  end
  
  desc "Check Certificates and Trigger Workflow for Expired or Missing Certificates"
  lane :check_and_renew_certificates do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
  
    # Authenticate using App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_content: ENV["FASTLANE_KEY"] # Ensure valid key content
    )
  
    # Initialize flag to track if renewal of certificates is needed
    new_certificate_needed = false
  
    # Fetch all certificates
    certificates = Spaceship::ConnectAPI::Certificate.all
  
    # Filter for Distribution Certificates
    distribution_certs = certificates.select { |cert| cert.certificate_type == "DISTRIBUTION" }
  
    # Handle case where no distribution certificates are found
    if distribution_certs.empty?
      puts "No Distribution certificates found! Triggering action to create certificate."
      new_certificate_needed = true
    else
      # Check for expiration
      distribution_certs.each do |cert|
        expiration_date = Time.parse(cert.expiration_date)
  
        puts "Current Distribution Certificate: #{cert.id}, Expiration date: #{expiration_date}"
  
        if expiration_date < Time.now
          puts "Distribution Certificate #{cert.id} is expired! Triggering action to renew certificate."
          new_certificate_needed = true
        else
          puts "Distribution certificate #{cert.id} is valid. No action required."
        end
      end
    end
  
    # Write result to new_certificate_needed.txt
    file_path = File.expand_path('new_certificate_needed.txt')
    File.write(file_path, new_certificate_needed ? 'true' : 'false')  
  
    # Log the absolute path and contents of the new_certificate_needed.txt file
    puts ""
    puts "Absolute path of new_certificate_needed.txt: #{file_path}"
    new_certificate_needed_content = File.read(file_path)
    puts "Certificate creation or renewal needed: #{new_certificate_needed_content}"
  end

  desc "Register the MooByte identifiers used by iPhone, iPad, Apple Watch, and Mac"
  lane :prepare_MooByteDevices do
    setup_ci if ENV['CI']
    app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )

    identifiers = {
      "MooByte iPhone and iPad" => "local.rabbitload",
      "MooByte Apple Watch" => "local.rabbitload.watch",
      "MooByte Mac" => "local.rabbitload.mac"
    }
    identifiers.each do |name, identifier|
      next if Spaceship::ConnectAPI::BundleId.find(identifier)
      Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
      UI.success("Registered #{identifier}")
    end
  end

  desc "Build and sign MooByte for iPhone, iPad, and the embedded Apple Watch app"
  lane :build_MooBytePhone do
    setup_ci if ENV['CI']
    source_root = File.join(GITHUB_WORKSPACE, "MooByteSource")
    project_path = File.join(source_root, "RabbitLoad.xcodeproj")
    api_key = app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    previous = latest_testflight_build_number(
      app_identifier: MOOBYTE_IOS_IDENTIFIER,
      platform: "ios",
      api_key: api_key,
      initial_build_number: 0
    )
    source_build_number = Integer(File.read(File.join(source_root, "Scripts/generate_project.py"))[/^PHONE_BUILD_VERSION = "(\d+)"$/, 1])
    next_build_number = [previous + 1, source_build_number].max
    match(
      type: "appstore",
      platform: "ios",
      readonly: false,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [MOOBYTE_IOS_IDENTIFIER, MOOBYTE_WATCH_IDENTIFIER, MOOBYTE_WIDGET_IDENTIFIER, MOOBYTE_SAFARI_IDENTIFIER, MOOBYTE_SHARE_IDENTIFIER],
      force: true # MooByte only; register/approve its new share group before dispatch.
    )
    mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    update_project_team(path: project_path, teamid: TEAMID)
    update_code_signing_settings(
      path: project_path,
      profile_name: mapping[MOOBYTE_IOS_IDENTIFIER],
      code_sign_identity: "Apple Distribution",
      targets: ["RabbitLoadPhone"]
    )
    update_code_signing_settings(
      path: project_path,
      profile_name: mapping[MOOBYTE_WATCH_IDENTIFIER],
      code_sign_identity: "Apple Distribution",
      targets: ["RabbitLoadWatch"]
    )
    update_code_signing_settings(
      path: project_path,
      profile_name: mapping[MOOBYTE_WIDGET_IDENTIFIER],
      code_sign_identity: "Apple Distribution",
      targets: ["MooByteWidgets"]
    )
    { MOOBYTE_SAFARI_IDENTIFIER => "MooByteSafari", MOOBYTE_SHARE_IDENTIFIER => "MooByteShare" }.each do |identifier, target|
      update_code_signing_settings(
        path: project_path,
        profile_name: mapping[identifier],
        code_sign_identity: "Apple Distribution",
        targets: [target]
      )
    end
    gym(
      project: project_path,
      export_method: "app-store",
      scheme: "RabbitLoadPhone",
      output_name: "MooByte.ipa",
      configuration: "Release",
      destination: "generic/platform=iOS",
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build_number}",
      buildlog_path: "buildlog-moobyte-phone",
      export_options: {
        provisioningProfiles: {
          MOOBYTE_IOS_IDENTIFIER => mapping[MOOBYTE_IOS_IDENTIFIER],
          MOOBYTE_WATCH_IDENTIFIER => mapping[MOOBYTE_WATCH_IDENTIFIER],
          MOOBYTE_WIDGET_IDENTIFIER => mapping[MOOBYTE_WIDGET_IDENTIFIER],
          MOOBYTE_SAFARI_IDENTIFIER => mapping[MOOBYTE_SAFARI_IDENTIFIER],
          MOOBYTE_SHARE_IDENTIFIER => mapping[MOOBYTE_SHARE_IDENTIFIER]
        }
      }
    )
    copy_artifacts(
      target_path: "artifacts-moobyte-phone",
      artifacts: ["MooByte.ipa", "*.dSYM.zip"]
    )
  end

  desc "Upload MooByte for iPhone, iPad, and Apple Watch to internal TestFlight"
  lane :release_MooBytePhone do
    api_key = app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    upload_to_testflight(
      api_key: api_key,
      app_identifier: MOOBYTE_IOS_IDENTIFIER,
      app_platform: "ios",
      ipa: "MooByte.ipa",
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  end

  desc "Build and sign Bunway for iPhone and iPad"
  lane :build_BunwayPhone do
    setup_ci if ENV['CI']
    identifier = "com.julienbell.bunway"
    project_path = File.join(GITHUB_WORKSPACE, "BunwaySource", "apple", "Bunway.xcodeproj")
    api_key = app_store_connect_api_key(key_id: FASTLANE_KEY_ID, issuer_id: FASTLANE_ISSUER_ID, key_content: FASTLANE_KEY)
    previous = latest_testflight_build_number(app_identifier: identifier, platform: "ios", api_key: api_key, initial_build_number: 0)
    match(type: "appstore", platform: "ios", readonly: false,
          git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
          app_identifier: [identifier])
    mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    update_project_team(path: project_path, teamid: TEAMID)
    update_code_signing_settings(path: project_path, profile_name: mapping[identifier],
                                 code_sign_identity: "Apple Distribution", targets: ["BunwayPhone"])
    gym(project: project_path, scheme: "BunwayPhone", export_method: "app-store",
        output_name: "BunwayPhone.ipa", configuration: "Release", destination: "generic/platform=iOS",
        xcargs: "CURRENT_PROJECT_VERSION=#{[previous + 1, 3].max}", buildlog_path: "buildlog-bunway-phone",
        export_options: {provisioningProfiles: {identifier => mapping[identifier]}})
  end

  desc "Upload Bunway iPhone to TestFlight"
  lane :release_BunwayPhone do
    api_key = app_store_connect_api_key(key_id: FASTLANE_KEY_ID, issuer_id: FASTLANE_ISSUER_ID, key_content: FASTLANE_KEY)
    upload_to_testflight(api_key: api_key, app_identifier: "com.julienbell.bunway", app_platform: "ios",
                         ipa: "BunwayPhone.ipa", skip_waiting_for_build_processing: false,
                         distribute_external: false)
  end
end

platform :tvos do
  desc "Confirm the existing LoopFollow universal app identifier"
  lane :prepare_LoopFollowTV do
    setup_ci if ENV['CI']
    api_key = app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key: FASTLANE_KEY
    )
    UI.user_error!("Existing LoopFollow App Store record was not found") unless Spaceship::ConnectAPI::App.find(TV_IDENTIFIER)
    UI.user_error!("Existing LoopFollow bundle identifier was not found") unless Spaceship::ConnectAPI::BundleId.find(TV_IDENTIFIER)
  end

  desc "Build the native Apple TV dashboard"
  lane :build_LoopFollowTV do
    setup_ci if ENV['CI']
    api_key = app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    previous = latest_testflight_build_number(
      app_identifier: TV_IDENTIFIER,
      platform: "appletvos",
      api_key: api_key,
      initial_build_number: 0
    )
    increment_build_number(xcodeproj: "#{GITHUB_WORKSPACE}/LoopFollow.xcodeproj", build_number: previous + 1)
    match(
      type: "appstore",
      platform: "tvos",
      readonly: false,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [TV_IDENTIFIER]
    )
    mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    update_project_team(path: "#{GITHUB_WORKSPACE}/LoopFollow.xcodeproj", teamid: TEAMID)
    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/LoopFollow.xcodeproj",
      profile_name: mapping[TV_IDENTIFIER],
      code_sign_identity: "Apple Distribution",
      targets: ["LoopFollowTV"]
    )
    gym(
      export_method: "app-store",
      scheme: "LoopFollowTV",
      output_name: "LoopFollowTV.ipa",
      configuration: "Release",
      destination: "generic/platform=tvOS",
      buildlog_path: "buildlog-tv",
      export_options: { provisioningProfiles: { TV_IDENTIFIER => mapping[TV_IDENTIFIER] } }
    )
    copy_artifacts(target_path: "artifacts-tv", artifacts: ["*.ipa", "*.dSYM.zip"])
  end

