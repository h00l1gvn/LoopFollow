platform :mac do
  desc "Build and sign the native MooByte Mac app"
  lane :build_MooByteMac do
    setup_ci if ENV['CI']
    source_root = File.join(GITHUB_WORKSPACE, "MooByteSource")
    project_path = File.join(source_root, "RabbitLoad.xcodeproj")
    api_key = app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    previous = latest_testflight_build_number(
      app_identifier: MOOBYTE_MAC_IDENTIFIER,
      platform: "osx",
      api_key: api_key,
      initial_build_number: 0
    )
    next_build_number = [previous + 1, 25].max
    match(
      type: "appstore",
      platform: "macos",
      readonly: false,
      additional_cert_types: ["mac_installer_distribution"],
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [MOOBYTE_MAC_IDENTIFIER, MOOBYTE_MAC_SAFARI_IDENTIFIER],
      force: true
    )
    mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    update_project_team(path: project_path, teamid: TEAMID)
    update_code_signing_settings(
      path: project_path,
      profile_name: mapping[MOOBYTE_MAC_IDENTIFIER],
      code_sign_identity: "Apple Distribution",
      targets: ["RabbitLoadMac"]
    )
    update_code_signing_settings(
      path: project_path,
      profile_name: mapping[MOOBYTE_MAC_SAFARI_IDENTIFIER],
      code_sign_identity: "Apple Distribution",
      targets: ["MooByteMacSafari"]
    )
    gym(
      project: project_path,
      export_method: "app-store",
      scheme: "RabbitLoadMac",
      output_name: "MooByteMac",
      configuration: "Release",
      destination: "generic/platform=macOS",
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build_number}",
      buildlog_path: "buildlog-moobyte-mac",
      export_options: {
        provisioningProfiles: {
          MOOBYTE_MAC_IDENTIFIER => mapping[MOOBYTE_MAC_IDENTIFIER],
          MOOBYTE_MAC_SAFARI_IDENTIFIER => mapping[MOOBYTE_MAC_SAFARI_IDENTIFIER]
        }
      }
    )
    copy_artifacts(
      target_path: "artifacts-moobyte-mac",
      artifacts: ["MooByteMac.pkg", "*.dSYM.zip"]
    )
  end

  desc "Upload the native MooByte Mac app to internal TestFlight"
  lane :release_MooByteMac do
    api_key = app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
    upload_to_testflight(
      api_key: api_key,
      app_identifier: MOOBYTE_MAC_IDENTIFIER,
      app_platform: "osx",
      pkg: "MooByteMac.pkg",
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  end
end
